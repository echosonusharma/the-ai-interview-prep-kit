# =============================================================================
# PrepPilot backend — environment template
# cp .env.example .env  &&  edit values for your machine
# =============================================================================

# --- Server ---
PORT=5000
# Batch fixtures serve company sites from localhost (§9): the crawler treats
# localhost as SSRF in production, so keep NODE_ENV != production for evaluate.
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/preppilot

# --- Auth ---
# Development: any string ≥16 chars. Production: random 32+ chars (never use defaults).
SESSION_SECRET=dev-secret-change-in-production-min-16-chars

# --- OpenCode Zen (https://opencode.ai/zen — free tier uses Bearer public) ---
# NOTE: the default below calls external OpenCode infra — set a private key
# for fully isolated runs.
OPENCODE_API_KEY=public
OPENCODE_PROJECT_ID=global
OPENCODE_USER_AGENT=opencode/1.18.27 ai-sdk/provider-utils/4.0.38 runtime/bun/1.3.14

# --- LLM pipeline ---
LLM_ZEN_MODELS=muse-spark-1.3-contributor-free,muse-spark-1.2-contributor-free,mimo-v2.5-free,big-pickle,nemotron-3-ultra-free
LLM_MAX_CALLS_PER_KIT=20
LLM_MAX_CONCURRENT=4
LLM_MAX_FALLBACKS=4
LLM_DEBUG_RAW=false

# --- Batch evaluate (§9) & API kit generation timeout (ms) ---
BATCH_CONCURRENCY=2
CASE_TIMEOUT_MS=240000
