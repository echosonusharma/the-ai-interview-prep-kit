{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.js": { "includeFiles": "dist/pipeline/prompts/*.md" },
    "src/app.ts": { "includeFiles": "src/pipeline/prompts/*.md" }
  }
}
